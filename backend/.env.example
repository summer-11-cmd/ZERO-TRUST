FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_DB_URL=https://zguard-iot-default-rtdb.firebaseio.com
LLM_API_KEY=your_openai_or_anthropic_api_key_here

# Email Alert Notifications (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=app_password_here
ALERT_EMAIL_TO=security@yourdomain.com

# Optional Twilio SMS Notifications
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+18005550199
ALERT_SMS_TO=+18005550123

